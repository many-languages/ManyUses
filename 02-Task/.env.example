# Copy this file to .env (in this same folder) and fill in real values.
# .env is gitignored -- never commit real credentials.
#
# Shared across every language's pipeline (not per-language) -- sourced
# once by lib/run_update_and_push.sh before it cds into any language
# folder. Loaded via: `source 02-Task/.env` (plain shell var assignments,
# no `export` needed if run_update_and_push.sh sources it directly, which
# it does).

# formr API credentials (OAuth2 client-credentials flow) -- used by
# formr_api_authenticate() in lib/push_to_formr_core.R and
# lib/pull_results_core.R, for formr_api_upload_survey() and
# formr_api_fetch_results() respectively. Create these at
# admin/account#api on your formr instance -- requires account level 2 --
# with at least the survey:write and data:read scopes, and copy
# client_id/client_secret immediately (shown once). See
# https://formr-admin.uni-muenster.de/public/documentation#api.
FORMR_CLIENT_ID=your-client-id
FORMR_CLIENT_SECRET=your-client-secret

# Only needed if formr is self-hosted / not the default https://rforms.org.
# Leave unset to use formr's own default. If self-hosted, check whether
# your instance routes the OAuth2/v1 API under /api (e.g.
# /api/oauth/access_token) rather than at the bare path the formr R
# package assumes -- if so, include /api in this URL, since
# formr_api_authenticate() builds every subsequent API URL relative to
# this same host.
# FORMR_HOST=https://formr.org
