# Copy this file to .env (in this same folder) and fill in real values.
# .env is gitignored -- never commit real credentials.
#
# Shared across every language's pipeline (not per-language) -- sourced
# once by lib/run_update_and_push.sh before it cds into any language
# folder. Loaded via: `source 02-Task/.env` (plain shell var assignments,
# no `export` needed if run_update_and_push.sh sources it directly, which
# it does).

# formr account that owns the manyuses-english run (and, later, every
# other language's run) -- used by formr_connect() in
# lib/pull_results_core.R and lib/push_to_formr.R.
FORMR_EMAIL=you@example.com
FORMR_PASSWORD=your-formr-password

# Only needed if formr is self-hosted / not the default https://rforms.org.
# Leave unset to use formr's own default.
# FORMR_HOST=https://formr.org
